---
const categories = [
  { name: '赚钱与生意', path: '/category/赚钱与生意' },
  { name: '个人成长', path: '/category/个人成长' },
  { name: '情绪价值', path: '/category/情绪价值' },
  { name: '行业分析', path: '/category/行业分析' },
  { name: '职场生存', path: '/category/职场生存' },
  { name: '经营故事', path: '/category/经营故事' },
  { name: '时事观察', path: '/category/时事观察' },
];
const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="一个创业者的思考 - 首页">
      <span class="brand-dot"></span>
      <span class="brand-name">一个创业者的思考</span>
    </a>
    <nav class="nav" aria-label="主导航">
      <ul>
        {
          categories.map((c) => (
            <li>
              <a href={c.path} class={pathname.startsWith(c.path) ? 'active' : ''}>{c.name}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <button class="nav-toggle" aria-label="打开菜单" id="navToggle">☰</button>
  </div>
</header>

<style>
  .site-header {
    background: var(--card);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: 0 1px 4px rgba(43,43,43,0.04);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 62px;
    gap: 20px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--text);
    font-weight: 700;
    font-size: 17px;
    white-space: nowrap;
  }
  .brand:hover { color: var(--text); }
  .brand-dot {
    width: 12px; height: 12px; border-radius: 3px;
    background: var(--accent);
    flex-shrink: 0;
  }
  .nav ul {
    list-style: none;
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }
  .nav a {
    display: block;
    padding: 7px 13px;
    border-radius: 999px;
    color: var(--text-soft);
    font-size: 14.5px;
    font-weight: 500;
  }
  .nav a:hover { color: var(--accent); background: var(--accent-soft); }
  .nav a.active { color: var(--accent); background: var(--accent-soft); font-weight: 600; }
  .nav-toggle {
    display: none;
    background: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 6px 12px;
    font-size: 18px;
    color: var(--text);
    cursor: pointer;
  }
  @media (max-width: 860px) {
    .nav { display: none; }
    .nav.open { display: block; position: absolute; top: 62px; left: 0; right: 0; background: var(--card); border-bottom: 1px solid var(--border); padding: 12px 20px; }
    .nav.open ul { flex-direction: column; gap: 2px; }
    .nav.open a { border-radius: var(--radius-sm); padding: 11px 14px; }
    .nav-toggle { display: block; }
  }
</style>

<script>
  const toggle = document.getElementById('navToggle');
  const nav = document.querySelector('.nav');
  toggle?.addEventListener('click', () => {
    nav?.classList.toggle('open');
  });
</script>
