---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const dateStr = post.data.date.toISOString().slice(0, 10);
const fullTitle = `${post.data.title} - 一个创业者的思考`;
const category = post.data.category;
const description = post.data.description;
---

<BaseLayout title={post.data.title} description={description}>
  <article class="article container">
    <header class="article-head">
      <a class="back" href={`/category/${category}`}>← {category}</a>
      <h1 class="article-title">{post.data.title}</h1>
      <div class="article-meta">
        <time datetime={dateStr}>{dateStr}</time>
        {
          post.data.tags.length > 0 && (
            <span class="tags">{post.data.tags.map((t) => `#${t}`).join(' ')}</span>
          )
        }
      </div>
    </header>

    <div class="article-body markdown">
      <Content />
    </div>

    <footer class="article-footer">
      <a class="btn" href="/">返回首页</a>
      <span class="footer-note">一个创业者的思考 · 把生意想明白</span>
    </footer>
  </article>
</BaseLayout>

<style>
  .article { padding-top: 34px; padding-bottom: 40px; max-width: 780px; }
  .article-head { margin-bottom: 30px; }
  .back {
    font-size: 13.5px;
    color: var(--text-soft);
    background: var(--bg-soft);
    padding: 5px 12px;
    border-radius: 999px;
    display: inline-block;
    margin-bottom: 18px;
  }
  .back:hover { color: var(--accent); }
  .article-title { font-size: 32px; line-height: 1.3; font-weight: 700; letter-spacing: -0.5px; margin-bottom: 14px; }
  .article-meta { display: flex; align-items: center; gap: 14px; font-size: 13.5px; color: var(--text-faint); }
  .tags { color: var(--accent); }
  .article-body { font-size: 16px; color: var(--text); }
  .article-footer { margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
  .footer-note { color: var(--text-faint); font-size: 13px; }

  @media (max-width: 768px) {
    .article-title { font-size: 25px; }
  }
</style>
